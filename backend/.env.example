# Generate a unique secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
CLEANTRACK_SECRET=replace-with-a-long-random-secret
# Render is HTTPS. The Vercel proxy keeps browser requests same-origin.
COOKIE_SECURE=1
# Attach a Render persistent disk mounted at /var/data for durable SQLite/uploads.
CLEANTRACK_DATA_DIR=/var/data
